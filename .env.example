# URL pública do console (sem barra no final)
APP_URL=https://iadasilva.com.br

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
#   Homepage URL:               https://iadasilva.com.br
#   Authorization callback URL: https://iadasilva.com.br/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Segredo para criptografar o cookie de sessão (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Repositório-template usado para criar novas squads (precisa estar marcado como "Template repository")
SQUAD_TEMPLATE_REPO=RGMThech/agentic-data-squad

# Tópico do GitHub que identifica repositórios de squad
SQUAD_TOPIC=agentic-data-squad

# Opcional: restringir quem pode entrar (logins ou organizações do GitHub, separados por vírgula).
# Vazio = qualquer conta GitHub entra, mas só enxerga as squads às quais já tem acesso no GitHub.
ALLOWED_GITHUB_USERS=
ALLOWED_GITHUB_ORGS=

# Apenas para GitHub Enterprise Server (deixe vazio no github.com)
GITHUB_URL=
GITHUB_API_URL=
