# URL pública do console (sem barra no final)
APP_URL=https://iadasilva.com.br

# Segredo do cookie de sessão e dos códigos de login (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------- banco de dados (MySQL da Hostinger)
# mysql://USUARIO:SENHA@HOST:3306/BANCO   (as tabelas são criadas sozinhas no primeiro acesso)
DATABASE_URL=

# ---------------------------------------------------------------- e-mail (envio dos códigos e convites)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@iadasilva.com.br
SMTP_PASS=
MAIL_FROM=no-reply@iadasilva.com.br

# Administradores iniciais (separados por vírgula): entram sem convite e não podem ser rebaixados pelo console
ADMIN_EMAILS=

# ---------------------------------------------------------------- GitHub App da organização
GITHUB_APP_ID=
# Chave privada do App (.pem). Pode colar o conteúdo em base64 — mais fácil em painéis de hospedagem:
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("chave.pem"))
#   Linux/macOS:          base64 -w0 chave.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_ORG=RGMThech

# Repositório-template das squads e tópico que identifica os repositórios de squad
SQUAD_TEMPLATE_REPO=RGMThech/agentic-data-squad
SQUAD_TOPIC=agentic-data-squad

# Apenas para GitHub Enterprise Server (deixe sem definir no github.com)
# GITHUB_API_URL=https://github.empresa.com/api/v3

# ---------------------------------------------------------------- somente desenvolvimento local
# DATABASE_URL=memory://      banco em memória (some ao reiniciar)
# MAIL_TRANSPORT=console      códigos de login impressos no terminal
